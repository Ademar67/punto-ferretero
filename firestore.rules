
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas básicas de seguridad: El usuario solo puede acceder a datos que le pertenecen (ownerId)
    match /products/{productId} {
      allow read, write: if request.auth != null;
    }
    match /sales/{saleId} {
      allow read, write: if request.auth != null;
    }
  }
}
